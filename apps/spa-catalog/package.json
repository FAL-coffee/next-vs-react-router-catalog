{
  "name": "spa-catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build && pnpm build:api",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",

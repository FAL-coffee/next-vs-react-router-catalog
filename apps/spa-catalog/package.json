  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13"
  }
